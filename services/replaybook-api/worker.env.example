# Copy to /etc/replaybook-api/worker.env and chmod 600.
AGENT_ZEN_GARDEN_CONTROL_PLANE_URL=https://zen.example.example
AGENT_ZEN_GARDEN_WORKER_NAME=warm-worker-01
