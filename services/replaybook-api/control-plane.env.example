# Copy to /etc/replaybook-api/control-plane.env and chmod 600.
AGENT_ZEN_GARDEN_BIND=127.0.0.1:8080
# State is stored in SQLite. Keep this file and the database readable only by
# the service user.
AGENT_ZEN_GARDEN_STATE_FILE=/var/lib/replaybook-api/state.db
# Per-client limits for public mutation endpoints (60-second windows).
AGENT_ZEN_GARDEN_RUNS_PER_MINUTE=30
AGENT_ZEN_GARDEN_ENROLLMENTS_PER_MINUTE=5
# Generate with: openssl rand -hex 32
AGENT_ZEN_GARDEN_JOIN_TOKEN=replace-with-a-long-random-token
